# Токен бота от @BotFather. Не коммить .env и не публикуй токен.
BOT_TOKEN=

DATA_DIR=./data
# Владельцы админки /admin. Всегда имеют доступ. Обязательно для запуска.
ADMIN_USER_IDS=
# Начальный список приглашённых. Импортируется в SQLite один раз;
# дальше добавляй и удаляй пользователей через /admin. Пусто — только администраторы.
ALLOWED_USER_IDS=

# Лимиты для публичного Telegram Bot API; качество всегда MP3 320 кбит/с.
MAX_DURATION_SECONDS=1200
MAX_UPLOAD_BYTES=49000000
MAX_DOWNLOAD_BYTES=200000000
MAX_WORKERS=2
MAX_QUEUE=8
PREVIEW_SECONDS=20
CACHE_HOURS=24
MAX_CACHE_BYTES=5000000000
DOWNLOAD_TIMEOUT_SECONDS=300
RENDER_TIMEOUT_SECONDS=300

# Необязательно: внешний Netscape cookies.txt. По умолчанию импорт хранится
# в DATA_DIR/auth/youtube.cookies.txt (команда srtube --import-cookies FILE).
YOUTUBE_COOKIES_FILE=
# Необязательно: прокси только для yt-dlp. Например http://127.0.0.1:8080
YOUTUBE_PROXY=
# Необязательно: адрес внутреннего PO Token provider (см. compose.youtube.yaml).
YOUTUBE_POT_PROVIDER_URL=
YOUTUBE_PLAYER_CLIENTS=default
YOUTUBE_MIN_INTERVAL_SECONDS=5
YOUTUBE_COOLDOWN_SECONDS=60
