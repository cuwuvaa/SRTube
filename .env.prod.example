# Этот файл остаётся на сервере. Токен и cookies хранятся отдельно в томе state.
ENVIRONMENT=production
BOT_TOKEN_FILE=/app/state/auth/bot.token
ADMIN_USER_IDS=
ALLOWED_USER_IDS=
DATA_DIR=/app/state
TRACKS_DIR=/app/tracks
RENDERER_SOCKET=/run/srtube/renderer.sock
MAX_WORKERS=1
MAX_QUEUE=3
FFMPEG_THREADS=1
MAX_CACHE_BYTES=1000000000
CACHE_HOURS=2
MAX_DOWNLOAD_BYTES=150000000
MIN_FREE_BYTES=512000000
YOUTUBE_MIN_INTERVAL_SECONDS=5
YOUTUBE_COOLDOWN_SECONDS=60
YOUTUBE_POT_PROVIDER_URL=
YOUTUBE_PROXY=
